# 운영: 회사가 열어준 공인 주소 (ngrok 대체, 개인 PC 의존 없음)
#   공인 183.100.200.135 한 IP를 포트로 분기 → :80=회사 WIMS / :9090=우리 WISM 백엔드
#   평문 http지만 AndroidManifest 에 usesCleartextTraffic="true" 있어 정상 동작.
API_BASE_URL=http://wism.win-tek.co.kr:9090/api/v1

# --- 상황별 대체 주소 (필요할 때 위 줄과 교체) ---
# ngrok(개인 PC 임시) : https://handlebar-skype-opt.ngrok-free.dev/api/v1
# 사내 WiFi LAN 직결  : http://<서버PC IP>:9090/api/v1
# 안드로이드 에뮬레이터 : http://10.0.2.2:9090/api/v1

USE_MOCK_AUTH=false
